# Hari Kripa Fruit ERP Environment Variables
# Private server-side Owner Master Recovery credentials (never expose in frontend or commit .env)
OWNER_RECOVERY_USERNAME=
OWNER_RECOVERY_PASSWORD=

# Internal server-side Developer CLI configuration (optional, never exposed in public login)
DEVELOPER_USERNAME=developer
DEVELOPER_INITIAL_PASSWORD=
# Optional shell-only secret when running `npm run dev:recover-password` for forgotten developer password recovery:
DEVELOPER_RECOVERY_PASSWORD=
